---
import Icon from './Icon.astro';

interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class="grid size-9 cursor-pointer place-items-center rounded-full border border-line text-fg-muted transition-colors hover:border-line-strong hover:text-fg"
>
  <Icon name="sun" class="dark:hidden" />
  <Icon name="moon" class="hidden dark:block" />
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const apply = () => {
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      };
      // Animate the switch where the View Transitions API is available
      if ('startViewTransition' in document && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.startViewTransition(apply);
      } else {
        apply();
      }
    });
  });
</script>
